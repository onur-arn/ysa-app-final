# Supabase → Project Settings → Data API (URL) and API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Push notifications (optional) — generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@youthstation.org

# GIF search in chats (optional, falls back to a small built-in set)
GIPHY_API_KEY=

# Sign-up e-mails (Kabul et / Reddet) and welcome e-mails — https://app.brevo.com → SMTP & API
BREVO_API_KEY=
BREVO_FROM_EMAIL=secretaire@youthstation.org
# Who receives sign-up requests
ADMIN_EMAIL=secretaire@youthstation.org

# Demo accounts (npm run seed:demo) — local databases only
SEED_DEMO_PASSWORD=

# iOS app push (Apple Developer → Keys → Apple Push Notifications service). Paste the .p8
# content on one line with \n between lines. Without these keys the app runs, without push.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=org.youthstation.ysa
